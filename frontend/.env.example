# Tile provider used in frontend/src/lib/config.js
NEXT_PUBLIC_MAP_PROVIDER=mapbox

# Provider API key/token (required for mapbox)
NEXT_PUBLIC_MAP_API_KEY=replace_with_mapbox_api_key

# Optional map style id for mapbox provider
NEXT_PUBLIC_MAP_STYLE_ID=mapbox/streets-v12

# Optional tile URL override for advanced/self-hosted setups
NEXT_PUBLIC_MAP_TILE_URL=

# Deployed backend origin (no trailing slash), e.g. https://<backend-domain>
NEXT_PUBLIC_API_BASE_URL=https://<backend-domain>
