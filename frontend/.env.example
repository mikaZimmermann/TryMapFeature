# Map provider used in frontend/src/lib/config.js
NEXT_PUBLIC_MAP_PROVIDER=leaflet

# Provider API key/token (required for non-Leaflet providers only)
NEXT_PUBLIC_MAP_API_KEY=

# Optional custom tile URL (Leaflet defaults to OSM standard tiles)
NEXT_PUBLIC_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
